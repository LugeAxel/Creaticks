{
  "name": "creaticks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,yellow \"npm run dev:fe\" \"npm run dev:be\"",
    "dev:fe": "vite",
    "dev:be": "node --watch backend/server.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "axios": "^1.7.9",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "socket.io-client": "^4.8.3",
    "vue": "^3.5.34",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.6",
    "@tsconfig/node24": "^24.0.4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.6",
    "typescript": "~5.8.3",
    "vite": "^8.0.12",
    "vue-tsc": "^2.2.8"
  }
}
